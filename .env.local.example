# ============================================
# GeraLink - Variaveis de Ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# Supabase (obrigatorio)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Supabase Service Role (obrigatorio para view tracking)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# OpenAI (obrigatorio para geracao com IA)
OPENAI_API_KEY=sk-sua-key-aqui
